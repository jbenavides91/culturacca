# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase
# (Supabase Dashboard → Project Settings → API).

# URL del proyecto, p. ej. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"

# Clave pública "anon" (o "publishable"). Es segura en el navegador porque
# el acceso a los datos lo controlan las políticas RLS.
VITE_SUPABASE_ANON_KEY="TU_ANON_KEY"

# IMPORTANTE: la clave secreta "service_role" NUNCA va aquí ni en el frontend.
# La Edge Function admin-usuarios la recibe automáticamente de Supabase.

# GEMINI_API_KEY / APP_URL: variables heredadas de AI Studio (no usadas por la app).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
